<?xml version="1.0" encoding="utf-8"?>
<!-- A service that does nothing. Its only job is to exist: Jetpack Compose sends
     accessibility events only while some accessibility service is enabled, and a
     UiAutomation client does not count. With this on, Compose screens push changes too. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1000"
    android:canRetrieveWindowContent="false"
    android:description="@string/noop_description" />
